# Copy to .env (gitignored) and fill in. Loaded with python-dotenv.

# OpenCode — key from https://opencode.ai/auth
OPENCODE_API_KEY=""
KONVEY_PROVIDER=opencode-go          # opencode-go | opencode (Zen) | minimax | inception
OPENCODE_MODEL_ID=                   # empty = provider default

# MiniMax direct (KONVEY_PROVIDER=minimax)
# MINIMAX_API_KEY=""
# KONVEY_MODEL_ID=MiniMax-M3

# Inception Labs (KONVEY_PROVIDER=inception)
# INCEPTION_API_KEY=""

# Narration reference clip (default: assets/voices/narrator.mp3)
# KONVEY_VOICE_REF=/path/to/clip.wav

# Streaming model replies (0 = one plain call, for a gateway that cannot stream)
# KONVEY_STREAM=1

# Chromium for the layout pass (default /usr/bin/chromium, else playwright's own download)
# KONVEY_CHROMIUM=/path/to/chromium

# Web app (web/README.md). It has no authentication: keep it on 127.0.0.1
# KONVEY_DATABASE_URL=postgresql://konvey:konvey@127.0.0.1:5432/konvey
# KONVEY_WEB_RUNS=out/web          # where web runs write their files
# KONVEY_WEB_MAX_RUNS=3            # how many runs may be going at once (0 = no cap)
# KONVEY_WEB_RENDER=0              # 0 skips the render (the API sets this per run)
