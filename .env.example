# Copy to .env (gitignored) and fill in. Loaded with python-dotenv.

# OpenCode — key from https://opencode.ai/auth
OPENCODE_API_KEY=""
KONVEY_PROVIDER=opencode-go          # opencode-go | opencode (Zen) | minimax | inception
OPENCODE_MODEL_ID=                   # empty = provider default

# MiniMax direct (KONVEY_PROVIDER=minimax)
# MINIMAX_API_KEY=""
# KONVEY_MODEL_ID=MiniMax-M3

# Inception Labs (KONVEY_PROVIDER=inception)
# INCEPTION_API_KEY=""

# Narration reference clip (default: assets/voices/narrator.mp3)
# KONVEY_VOICE_REF=/path/to/clip.wav
